{
  "name": "wowolwin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts --dev",
    "dev:client": "vite",
    "build": "tsc --noEmit && npm run content:check && vite build",
    "content:check": "tsx src/content/check.ts",
    "start": "npm run build && tsx src/server/index.ts --fresh",
    "rehearse": "npm run build && tsx src/server/index.ts --rehearse --fresh",
    "resume": "tsx src/server/index.ts",
    "mcp": "tsx src/server/mcp.ts",
    "mcp:tunnel": "concurrently -n mcp,tunnel \"npm run mcp\" \"npx cloudflared tunnel --url http://127.0.0.1:3333\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/qrcode": "^1.5.6",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-git": "^4.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
